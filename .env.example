# Example environment variables for local development.
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# `docker-compose.yml` and `src/main/resources/application.yml` read these
# via environment variables (with the same defaults shown below).

# --- Server ---
SERVER_PORT=8081

# --- Database (local docker-compose and AWS RDS both use MySQL) ---
DB_URL=jdbc:mysql://127.0.0.1:3306/insurance
DB_USERNAME=root
DB_PASSWORD=0000
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=30000

# --- JWT ---
# Generate a strong secret for anything beyond local development, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-for-jwt-signing-please-1234567890
JWT_EXPIRATION_MS=3600000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Misc ---
SHUTDOWN_TIMEOUT=20s
